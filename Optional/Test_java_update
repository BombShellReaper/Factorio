const readline = require("readline");
const fs = require("fs");
const { execSync } = require("child_process");

const rl = readline.createInterface({
  input: process.stdin,
  output: process.stdout
});

// Utility function to prompt the user for input
const prompt = (query) => {
  return new Promise((resolve) => rl.question(query, resolve));
};

(async () => {
  try {
    // Prompt user for input
    const FACTORIO_DIR = await prompt("Enter the Factorio directory path: ");
    const BACKUP_DIR = `${FACTORIO_DIR}/backup`;
    const DOWNLOADS_DIR = `${FACTORIO_DIR}/downloads`;
    const LOGS_DIR = `${FACTORIO_DIR}/logs`;
    const CHECKSUM_FILE = `${DOWNLOADS_DIR}/factorio_checksum.txt`;

    const SCREEN_NAME = await prompt("Enter the name for the screen session: ");
    const BACKUP_NAME = `${BACKUP_DIR}/${await prompt("Enter the desired backup directory name: ")}`;
    const LOG_NAME = await prompt("Enter the desired log name: ");
    const UPDATE_LOG_FILE = `${LOGS_DIR}/${LOG_NAME}-${new Date().toISOString().replace(/[:.]/g, "_")}.txt`;
    const SAVE_FILE = `${FACTORIO_DIR}/factorio/saves/${await prompt("Enter the save file name (with .zip extension): ")}`;
    const SERVER_SETTINGS = `${FACTORIO_DIR}/factorio/data/server-settings.json`;
    const SERVER_PORT = await prompt("Enter the server port (default 34197): ") || "34197";

    const FACTORIO_URL = "https://factorio.com/get-download/stable/headless/linux64";
    const FACTORIO_FILE = `factorio-headless_linux-${new Date().toISOString().split("T")[0]}.tar.xz`;

    // Ensure necessary directories exist
    [LOGS_DIR, FACTORIO_DIR, DOWNLOADS_DIR].forEach((dir) => {
      if (!fs.existsSync(dir)) {
        fs.mkdirSync(dir, { recursive: true });
      }
    });

    // Log helper
    const log = (message) => {
      fs.appendFileSync(UPDATE_LOG_FILE, `${new Date().toISOString()} - ${message}\n`);
      console.log(message);
    };

    log("========== Update Process Started ==========");

    // Step 1: Check checksum
    let newChecksum;
    try {
      newChecksum = execSync(`wget -qO- "${FACTORIO_URL}" | sha256sum | awk '{print $1}'`).toString().trim();
    } catch (err) {
      log("Error fetching checksum: " + err.message);
      process.exit(1);
    }

    if (fs.existsSync(CHECKSUM_FILE)) {
      const previousChecksum = fs.readFileSync(CHECKSUM_FILE, "utf8").trim();
      if (newChecksum === previousChecksum) {
        log("Checksum matches. Skipping download.");
        process.exit(0);
      }
    }

    log("Checksum mismatch or file missing. Proceeding with download.");

    // Step 2: Download server
    try {
      execSync(`wget -v -O "${DOWNLOADS_DIR}/${FACTORIO_FILE}" "${FACTORIO_URL}"`);
      log("Download successful.");
      fs.writeFileSync(CHECKSUM_FILE, newChecksum);
    } catch (err) {
      log("Error downloading server: " + err.message);
      process.exit(1);
    }

    // Step 3: Backup current server
    if (fs.existsSync(BACKUP_NAME)) {
      log("Removing existing backup...");
      fs.rmSync(BACKUP_NAME, { recursive: true });
    }

    try {
      fs.cpSync(FACTORIO_DIR, BACKUP_NAME, { recursive: true });
      log(`Backup created at ${BACKUP_NAME}`);
    } catch (err) {
      log("Error creating backup: " + err.message);
      process.exit(1);
    }

    // Step 4: Extract downloaded server
    try {
      execSync(`mkdir -p "${FACTORIO_DIR}/factorio" && tar -xvf "${DOWNLOADS_DIR}/${FACTORIO_FILE}" --strip-components=1 -C "${FACTORIO_DIR}/factorio"`);
      log("Extraction completed.");
    } catch (err) {
      log("Error extracting server: " + err.message);
      process.exit(1);
    }

    // Step 5: Start Factorio server
    try {
      execSync(`screen -dmS "${SCREEN_NAME}" "${FACTORIO_DIR}/factorio/bin/x64/factorio" --start-server "${SAVE_FILE}" --server-settings "${SERVER_SETTINGS}" --port "${SERVER_PORT}"`);
      log(`Factorio server started in screen session: ${SCREEN_NAME}`);
    } catch (err) {
      log("Error starting server: " + err.message);
      process.exit(1);
    }

    log("========== Update Process Completed ==========");
    rl.close();
  } catch (err) {
    console.error("Unexpected error: ", err);
    rl.close();
    process.exit(1);
  }
})();
